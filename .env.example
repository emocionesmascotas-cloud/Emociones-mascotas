# =============================================================================
# EMOCIONES MASCOTAS - CONFIGURACIÓN DE ENTORNO
# =============================================================================
# Copia este archivo como .env y completa los valores
# NUNCA subas el archivo .env a Git (ya está en .gitignore)

# =============================================================================
# 🔥 SUPABASE CLOUD (FASE 1 - ACTUAL)
# =============================================================================
# Proyecto en Supabase Cloud (Free Tier)
# Pasos:
# 1. Ve a https://supabase.com/dashboard
# 2. Crea un nuevo proyecto o selecciona el existente
# 3. Ve a Settings > API
# 4. Copia las credenciales de abajo

# URL del proyecto (formato: https://xxxxx.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (usada en el frontend/cliente)
# Empieza con eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de servicio (solo para server/admin, NUNCA en frontend)
# Empieza con eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Schema de la base de datos (por defecto: public)
SUPABASE_SCHEMA=public

# =============================================================================
# 🗄️ BASE DE DATOS (PostgreSQL - Supabase)
# =============================================================================
# URL de conexión directa a PostgreSQL (para scripts de migración)
# Formato: postgres://postgres:[PASSWORD]@[HOST]:5432/postgres
# La encuentras en Supabase Dashboard > Settings > Database
DATABASE_URL=postgres://postgres:TU_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# =============================================================================
# 📋 NOTION - Documentación y Tareas
# =============================================================================
# Token de integración de Notion
# Pasos:
# 1. Ve a https://www.notion.so/my-integrations
# 2. Crea una nueva integración "Emociones Mascotas Bot"
# 3. Copia el Internal Integration Token (empieza con ntn_)
NOTION_INTEGRATION_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de la base de datos de tareas en Notion (opcional)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_TASKS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# 📱 TELEGRAM - Notificaciones y Comandos
# =============================================================================
# Token del bot de Telegram
# Pasos:
# 1. Abre Telegram y busca @BotFather
# 2. Envía /newbot
# 3. Sigue las instrucciones y copia el token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Tu Chat ID (para recibir notificaciones)
TELEGRAM_CHAT_ID=123456789

# =============================================================================
# 🌊 PIPEDREAM - Automatización y Webhooks
# =============================================================================
PIPEDREAM_WEBHOOK_SECRET=your_random_secret_here
WEBHOOK_SECRET=your_random_secret_here

# =============================================================================
# 🐙 GITHUB - Repositorio y Automatización
# =============================================================================
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_REPO=emocionesmascotas-cloud/Emociones-mascotas

# =============================================================================
# 🚀 APLICACIÓN
# =============================================================================
DEBUG=true
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# =============================================================================
# 🔐 SEGURIDAD
# =============================================================================
# JWT Secret para autenticación (genera uno aleatorio de 32+ chars)
JWT_SECRET=genera-un-secret-de-al-menos-32-caracteres-aqui

# =============================================================================
# 🏷️ METADATA
# =============================================================================
SITE_URL=http://localhost:8000
APP_NAME=Emociones Mascotas

# =============================================================================
# 📍 NOTAS
# =============================================================================
# 1. NUNCA subas este archivo a Git
# 2. Usa valores reales en producción
# 3. Para FASE 2 (auto-hosting), ver: infra/future/
