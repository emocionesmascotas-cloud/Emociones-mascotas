# =============================================================================
# EMOCIONES MASCOTAS - CONFIGURACIÓN DE ENTORNO
# =============================================================================
# Copia este archivo como .env y completa los valores
# NUNCA subas el archivo .env a Git (ya está en .gitignore)

# =============================================================================
# NOTION - Documentación y Tareas
# =============================================================================
# Token de integración de Notion
# Pasos:
# 1. Ve a https://www.notion.so/my-integrations
# 2. Crea una nueva integración "Emociones Mascotas Bot"
# 3. Copia el Internal Integration Token (empieza con ntn_)
NOTION_INTEGRATION_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de la base de datos de tareas en Notion (opcional)
# Lo encontrarás en la URL de tu database:
# https://notion.so/workspace/<DATABASE_ID>?v=...
NOTION_TASKS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# TELEGRAM - Notificaciones y Comandos
# =============================================================================
# Token del bot de Telegram
# Pasos:
# 1. Abre Telegram y busca @BotFather
# 2. Envía /newbot
# 3. Sigue las instrucciones y copia el token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Tu Chat ID (para recibir notificaciones)
# Pasos:
# 1. Envía un mensaje a @userinfobot en Telegram
# 2. Copia el ID numérico que devuelve
TELEGRAM_CHAT_ID=123456789

# =============================================================================
# PIPEDREAM - Automatización y Webhooks
# =============================================================================
# Secreto para validar webhooks de Pipedream
# Pasos:
# 1. En Pipedream, ve a tu workflow
# 2. En el step de HTTP Request, genera un secret
# 3. Copia el secret generado
PIPEDREAM_WEBHOOK_SECRET=your_random_secret_here

# Alias para el mismo secreto (usado en algunas funciones)
WEBHOOK_SECRET=your_random_secret_here

# =============================================================================
# GITHUB - Repositorio y Automatización
# =============================================================================
# Token personal de GitHub (opcional, para API)
# Se necesita para ciertas operaciones automatizadas
# Generar en: https://github.com/settings/tokens
# Scopes recomendados: repo, workflow, read:user
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Repositorio principal por defecto
DEFAULT_REPO=emocionesmascotas-cloud/Emociones-mascotas

# =============================================================================
# APLICACIÓN
# =============================================================================
# Modo debug (true = más logs, false = producción)
DEBUG=true

# Nivel de logging
# Opciones: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Puerto del servidor
# Replit usa el 5000 por defecto
PORT=5000

# Host (0.0.0.0 para escuchar en todas las interfaces)
HOST=0.0.0.0

# =============================================================================
# BASE DE DATOS (SQLite - local)
# =============================================================================
# Ruta de la base de datos
DATABASE_URL=sqlite:///./data/emociones_mascotas.db

# =============================================================================
# REPLIT (Configuración automática en Replit)
# =============================================================================
# No necesitas configurar estas variables en Replit
# Se configuran automáticamente

# Replit URL (para webhooks)
# REPLIT_URL=https://tu-proyecto.your-repl.repl.co

# =============================================================================
# NOTAS DE SEGURIDAD
# =============================================================================
# 1. NUNCA compartas tus tokens/secretos
# 2. Usa variables de entorno, nunca hardcodees valores
# 3. En producción, usa un gestor de secrets (Replit Secrets, Vault, etc.)
# 4. Rota los tokens periódicamente
# 5. Limita los permisos al mínimo necesario
